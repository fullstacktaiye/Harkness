{
  "v": 1,
  "id": "disallowed_capability",
  "steps": [
    {
      "expect": {
        "kind": "run_started"
      },
      "action": {
        "kind": "call_tool",
        "tool_id": "process.exec",
        "tool_version": "1.0.0",
        "input": {
          "argv": [
            "fixture-disallowed"
          ],
          "timeout_seconds": 120
        }
      }
    },
    {
      "expect": {
        "kind": "policy_denied",
        "reason_contains": "capability"
      },
      "action": {
        "kind": "complete_run",
        "summary": "Observed and reported the disallowed capability."
      }
    }
  ]
}
