{
  "v": 1,
  "id": "tool_timeout",
  "steps": [
    {
      "expect": {
        "kind": "run_started"
      },
      "action": {
        "kind": "call_tool",
        "tool_id": "process.exec",
        "tool_version": "1.0.0",
        "input": {
          "argv": [
            "fixture-hang",
            "--exact",
            "scenario_process_fixture_hang_child",
            "--ignored",
            "--nocapture"
          ],
          "timeout_seconds": 1
        }
      }
    },
    {
      "expect": {
        "kind": "tool_result",
        "output_contains": {
          "timed_out": true
        }
      },
      "action": {
        "kind": "complete_run",
        "summary": "Observed and reported the tool timeout."
      }
    }
  ]
}
