{
  "v": 1,
  "id": "tool_timeout",
  "steps": [
    {
      "expect": {
        "kind": "run_started"
      },
      "action": {
        "kind": "call_tool",
        "tool_id": "process.exec",
        "tool_version": "1.0.0",
        "input": {
          "argv": [
            "fixture-hang"
          ],
          "timeout_seconds": 1
        }
      }
    },
    {
      "expect": {
        "kind": "tool_failed",
        "error_kind": "timed_out"
      },
      "action": {
        "kind": "complete_run",
        "summary": "Observed and reported the tool timeout."
      }
    }
  ]
}
