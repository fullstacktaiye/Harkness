{
  "v": 1,
  "id": "restart_recovery",
  "steps": [
    {
      "expect": {
        "kind": "run_started"
      },
      "action": {
        "kind": "call_tool",
        "tool_id": "fs.read",
        "tool_version": "1.0.0",
        "input": {
          "path": "src/lib.rs"
        }
      }
    },
    {
      "expect": {
        "kind": "tool_failed",
        "error_kind": "interrupted"
      },
      "action": {
        "kind": "fail_run",
        "reason": {
          "kind": "interrupted",
          "reason": "The recorded call was interrupted before restart."
        }
      }
    }
  ]
}
