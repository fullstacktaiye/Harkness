{
  "v": 1,
  "id": "invalid_tool_input",
  "steps": [
    {
      "expect": {
        "kind": "run_started"
      },
      "action": {
        "kind": "call_tool",
        "tool_id": "fs.read",
        "tool_version": "1.0.0",
        "input": {
          "path": 42
        }
      }
    },
    {
      "expect": {
        "kind": "tool_failed",
        "error_kind": "invalid_input"
      },
      "action": {
        "kind": "complete_run",
        "summary": "The runtime rejected the deliberately invalid input before execution."
      }
    }
  ]
}
