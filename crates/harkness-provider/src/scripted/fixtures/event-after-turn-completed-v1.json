{
  "v": 1,
  "id": "event_after_turn_completed",
  "capabilities": {
    "context_window": 128000,
    "max_output_tokens": 4096,
    "supports_streaming": true,
    "supports_tool_calls": true,
    "supports_structured_output": false,
    "supports_token_counting": false
  },
  "steps": [
    {
      "step": "advance",
      "millis": 21
    },
    {
      "step": "emit",
      "event": {
        "kind": "turn_started",
        "provider_request_id": "scripted-21"
      }
    },
    {
      "step": "emit",
      "event": {
        "kind": "text_delta",
        "text": "All done."
      }
    },
    {
      "step": "emit",
      "event": {
        "kind": "turn_completed",
        "stop": "end_turn"
      }
    },
    {
      "step": "emit",
      "event": {
        "kind": "text_delta",
        "text": " Or is it?"
      }
    }
  ]
}
