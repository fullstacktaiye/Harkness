{
  "v": 1,
  "id": "split_arguments_tool_call",
  "capabilities": {
    "context_window": 128000,
    "max_output_tokens": 4096,
    "supports_streaming": true,
    "supports_tool_calls": true,
    "supports_structured_output": false,
    "supports_token_counting": false
  },
  "steps": [
    {
      "step": "advance",
      "millis": 30
    },
    {
      "step": "emit",
      "event": {
        "kind": "turn_started",
        "provider_request_id": "scripted-4"
      }
    },
    {
      "step": "emit",
      "event": {
        "kind": "tool_call_started",
        "index": 0,
        "id": "call_search_1",
        "name": "workspace.search"
      }
    },
    {
      "step": "arguments",
      "index": 0,
      "text": "{\"query\":\"café ☕\",\"limit\":5}",
      "split_at": [
        8,
        14,
        17,
        22
      ]
    },
    {
      "step": "emit",
      "event": {
        "kind": "tool_call_ready",
        "index": 0
      }
    },
    {
      "step": "emit",
      "event": {
        "kind": "turn_completed",
        "stop": "tool_use"
      }
    }
  ]
}
